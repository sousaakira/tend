{
  "manifest_version": 3,
  "name": "tend",
  "version": "0.2.0",
  "description": "Pick elements on a page, write notes on them, and hand them to the tend session's agents.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "scripting",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "tend: pick elements and write notes for the agents (Alt+Shift+T)"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Pick an element for tend"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
